# Optional UN Comtrade subscription key. Preview mode works without one but is rate-limited.
COMTRADE_API_KEY=
# Set to 1 to attempt live retrieval when running main.py.
DIAMOND_LIVE_DATA=0
# Annual periods, comma-separated. Keep requests modest.
COMTRADE_YEARS=2022,2023,2024
# Seconds between uncached preview requests. Increase if Comtrade returns HTTP 429.
COMTRADE_REQUEST_DELAY=6
# Limit reporters during testing, or leave as the default comma-separated codes.
COMTRADE_REPORTERS=842,699,56,376,784,72,710,124
# Optional official KP global-summary PDF. The pipeline also checks data/external/.
KP_GLOBAL_SUMMARY_URL=https://kimberleyprocessstatistics.org/static/pdfs/public_statistics/2024/2024GlobalSummary.pdf
KP_EXPECTED_YEAR=2024
